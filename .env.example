APP_NAME=Affiliate Auto Poster API
ENVIRONMENT=development
DEBUG=false

API_V1_PREFIX=/api/v1

DATABASE_URL=sqlite:///./affiliate.db

SHOPEE_CACHE_TTL_MINUTES=60
SHOPEE_REQUEST_TIMEOUT_SECONDS=10
IMAGE_OUTPUT_DIR=generated_images
IMAGE_REQUEST_TIMEOUT_SECONDS=10
SCHEDULER_PUBLISHER_MODE=audit
SCHEDULER_WEBHOOK_URL=
SCHEDULER_WEBHOOK_TIMEOUT_SECONDS=10

SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256

LOG_LEVEL=INFO
