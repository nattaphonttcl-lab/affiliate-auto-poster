APP_NAME=Affiliate Auto Poster API
ENVIRONMENT=development
DEBUG=false

API_V1_PREFIX=/api/v1

DATABASE_URL=sqlite:///./affiliate.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800

SHOPEE_CACHE_TTL_MINUTES=60
SHOPEE_REQUEST_TIMEOUT_SECONDS=10
IMAGE_OUTPUT_DIR=generated_images
IMAGE_REQUEST_TIMEOUT_SECONDS=10
SCHEDULER_PUBLISHER_MODE=audit
SCHEDULER_WEBHOOK_URL=
SCHEDULER_WEBHOOK_TIMEOUT_SECONDS=10

SECRET_KEY=replace-with-a-long-random-secret
SECRET_KEY_FILE=
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
SECURITY_CSP=default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' http: https: ws: wss:
SECURITY_HSTS_ENABLED=false
SECURITY_HSTS_MAX_AGE=31536000

LOG_LEVEL=INFO
LOG_JSON=true

TRACING_ENABLED=true
TRACING_SERVICE_NAME=affiliate-auto-poster-backend
TRACING_OTLP_ENDPOINT=

REDIS_ENABLED=false
REDIS_URL=redis://redis:6379/0
API_CACHE_TTL_SECONDS=60
IMAGE_CACHE_TTL_SECONDS=3600

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_ACCESS_KEY_FILE=
MINIO_SECRET_KEY=minioadmin
MINIO_SECRET_KEY_FILE=
MINIO_BUCKET_NAME=affiliate-assets
MINIO_SECURE=false

WORKERS_POLL_SECONDS=10
WORKERS_DEFAULT_OWNER_USER_ID=1
