APP_NAME=Affiliate Auto Poster API
ENVIRONMENT=production
DEBUG=false
TZ=UTC

API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:////data/affiliate.db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_RECYCLE_SECONDS=1800

SECRET_KEY=replace-with-64-plus-random-characters
SECRET_KEY_FILE=
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256

INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD_FILE=/run/secrets/initial_admin_password

CORS_ALLOWED_ORIGINS=https://app.example.com
CORS_ALLOW_CREDENTIALS=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
SECURITY_HSTS_ENABLED=true
SECURITY_HSTS_MAX_AGE=31536000

LOG_LEVEL=INFO
LOG_JSON=true

TRACING_ENABLED=true
TRACING_SERVICE_NAME=affiliate-auto-poster-backend
TRACING_OTLP_ENDPOINT=

REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0
API_CACHE_TTL_SECONDS=60
IMAGE_CACHE_TTL_SECONDS=3600

IMAGE_OUTPUT_DIR=/app/generated_images
IMAGE_REQUEST_TIMEOUT_SECONDS=10
IMAGE_STORAGE_BACKEND=local
IMAGE_STORAGE_LOCAL_DIR=/app/generated_images
IMAGE_STORAGE_BUCKET=
IMAGE_STORAGE_ENDPOINT=
IMAGE_TEMPLATE_CACHE_TTL_SECONDS=300
IMAGE_PROVIDER_ENCRYPTION_KEY=replace-with-unique-image-provider-key

AI_PROVIDER_ENCRYPTION_KEY=replace-with-unique-ai-provider-key
OPENAI_API_KEY_FILE=
GEMINI_API_KEY_FILE=
CLAUDE_API_KEY_FILE=
DEEPSEEK_API_KEY_FILE=
OPENROUTER_API_KEY_FILE=

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY_FILE=/run/secrets/minio_access_key
MINIO_SECRET_KEY_FILE=/run/secrets/minio_secret_key
MINIO_BUCKET_NAME=affiliate-assets
MINIO_SECURE=false

MINIO_ROOT_USER=replace-minio-root-user
MINIO_ROOT_PASSWORD=replace-minio-root-password
GRAFANA_ADMIN_USER=replace-grafana-user
GRAFANA_ADMIN_PASSWORD=replace-grafana-password

WORKERS_POLL_SECONDS=10
WORKERS_DEFAULT_OWNER_USER_ID=1