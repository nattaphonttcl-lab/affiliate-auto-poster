APP_NAME=Affiliate Auto Poster API
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

DATABASE_URL=sqlite:///./affiliate.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800

SECRET_KEY=replace-with-dev-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256

LOG_LEVEL=DEBUG
LOG_JSON=true

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
RATE_LIMIT_REQUESTS_PER_MINUTE=500
SECURITY_HSTS_ENABLED=false

TRACING_ENABLED=false
TRACING_SERVICE_NAME=affiliate-auto-poster-backend
TRACING_OTLP_ENDPOINT=

REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
API_CACHE_TTL_SECONDS=30
IMAGE_CACHE_TTL_SECONDS=300

IMAGE_STORAGE_BACKEND=local
IMAGE_STORAGE_LOCAL_DIR=generated_images

WORKERS_POLL_SECONDS=10
WORKERS_DEFAULT_OWNER_USER_ID=1
