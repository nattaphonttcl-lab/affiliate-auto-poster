APP_NAME=Affiliate Auto Poster API
ENVIRONMENT=production
DEBUG=false
API_V1_PREFIX=/api/v1

DATABASE_URL=sqlite:///./affiliate.db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_RECYCLE_SECONDS=1800

SECRET_KEY=replace-with-production-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256

LOG_LEVEL=INFO
LOG_JSON=true

CORS_ALLOWED_ORIGINS=https://app.example.com
CORS_ALLOW_CREDENTIALS=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
SECURITY_HSTS_ENABLED=true

TRACING_ENABLED=true
TRACING_SERVICE_NAME=affiliate-auto-poster-backend
TRACING_OTLP_ENDPOINT=

REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0
API_CACHE_TTL_SECONDS=60
IMAGE_CACHE_TTL_SECONDS=3600

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=affiliate-assets
MINIO_SECURE=false

IMAGE_STORAGE_BACKEND=local
IMAGE_STORAGE_LOCAL_DIR=generated_images

WORKERS_POLL_SECONDS=10
WORKERS_DEFAULT_OWNER_USER_ID=1
